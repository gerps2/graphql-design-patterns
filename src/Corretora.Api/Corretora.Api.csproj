<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- O Hot Chocolate importa GreenDonut (que tem um Result<T>) e HotChocolate (que tem um Error).
       Os dois colidem com Common.Results. Quem usa o Hot Chocolate importa o namespace no próprio arquivo. -->
  <Target Name="TirarUsingsQueColidem" BeforeTargets="GenerateGlobalUsings;ResolveAssemblyReferences;CoreCompile">
    <ItemGroup>
      <Using Remove="GreenDonut" />
      <Using Remove="HotChocolate" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.3" />
    <PackageReference Include="HotChocolate.Data" Version="16.7.3" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="16.7.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

</Project>
